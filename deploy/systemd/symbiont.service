[Unit]
Description=Symbiont resident organism
Documentation=https://github.com/alessbarb/symbiont-lab
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/symbiont-lab organism live
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/symbiont
LockPersonality=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=default.target
