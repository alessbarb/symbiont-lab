{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://symbiont.local/observatory/body_schema.schema.json",
  "title": "Symbiont Body Schema",
  "description": "Organism-owned bounded self-knowledge. Version 1 is the historical sensory body; version 2 adds learned opaque cognitive regions and weak functional dependencies. Private checkpoint learning state is never part of this observer contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state", "parts", "dependencies", "global_state"],
  "properties": {
    "schema_version": { "enum": [1, 2] },
    "state": { "enum": ["undeveloped", "partial"] },
    "parts": {
      "type": "array",
      "maxItems": 288,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["part_id", "kind", "existence_confidence_class", "confidence_class", "maturity_class", "recency_class"],
        "properties": {
          "part_id": { "type": "string", "maxLength": 44 },
          "kind": { "enum": ["sense", "cognitive_region"] },
          "existence_confidence_class": { "type": "integer", "minimum": 0, "maximum": 15 },
          "health_class": { "type": "integer", "minimum": 0, "maximum": 15 },
          "confidence_class": { "type": "integer", "minimum": 0, "maximum": 15 },
          "cost_class": { "type": "integer", "minimum": 0, "maximum": 15 },
          "activity_class": { "type": "integer", "minimum": 0, "maximum": 15 },
          "maturity_class": { "type": "integer", "minimum": 0, "maximum": 7 },
          "recency_class": { "type": "integer", "minimum": 0, "maximum": 4 }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "sense" } }, "required": ["kind"] },
            "then": {
              "required": ["health_class", "cost_class"],
              "properties": { "part_id": { "pattern": "^part\\.sense\\.[0-9a-f]{32}$" } },
              "not": { "required": ["activity_class"] }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "cognitive_region" } }, "required": ["kind"] },
            "then": {
              "required": ["activity_class"],
              "properties": { "part_id": { "pattern": "^part\\.region\\.[0-9a-f]{32}$" } },
              "not": {
                "anyOf": [
                  { "required": ["health_class"] },
                  { "required": ["cost_class"] }
                ]
              }
            }
          }
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "target_id", "relation", "confidence_class", "support_class"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^part\\.region\\.[0-9a-f]{32}$" },
          "target_id": { "type": "string", "pattern": "^part\\.region\\.[0-9a-f]{32}$" },
          "relation": { "enum": ["co_acts_with", "precedes"] },
          "confidence_class": { "type": "integer", "minimum": 0, "maximum": 15 },
          "support_class": { "type": "integer", "minimum": 0, "maximum": 15 }
        }
      }
    },
    "global_state": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": 1 } }, "required": ["schema_version"] },
      "then": {
        "properties": {
          "parts": {
            "maxItems": 256,
            "items": { "properties": { "kind": { "const": "sense" } } }
          },
          "dependencies": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "undeveloped" } }, "required": ["state"] },
      "then": {
        "properties": {
          "parts": { "maxItems": 0 },
          "dependencies": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "partial" } }, "required": ["state"] },
      "then": { "properties": { "parts": { "minItems": 1 } } }
    }
  ]
}
