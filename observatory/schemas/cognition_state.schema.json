{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://symbiont.local/observatory/cognition_state.schema.json",
  "title": "Symbiont Observatory Cognition State",
  "description": "Per-tick cognition telemetry including evidence-gated stranded-concept and shadow-prediction metrics. Never raw weights.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topology_revision",
    "safety_state"
  ],
  "properties": {
    "topology_revision": {
      "type": "integer",
      "minimum": 0
    },
    "topology_health": {
      "type": "string",
      "enum": [
        "germinal",
        "developing",
        "connected",
        "adaptive",
        "degenerate",
        "recovering"
      ]
    },
    "recovering": {
      "type": "boolean"
    },
    "activation_classes": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 15
      }
    },
    "readouts": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": {
        "type": "number"
      }
    },
    "prediction_errors": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": {
        "type": "string",
        "enum": [
          "zero",
          "trace",
          "low",
          "medium",
          "high",
          "extreme"
        ]
      }
    },
    "edge_deltas": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "target_id",
          "weight_class",
          "eligibility_class"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "maxLength": 128
          },
          "target_id": {
            "type": "string",
            "maxLength": 128
          },
          "weight_class": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "eligibility_class": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          }
        }
      }
    },
    "mutations": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "add_edge",
              "add_node",
              "quarantine_edge",
              "remove_edge",
              "remove_node"
            ]
          },
          "node_id": {
            "type": "string",
            "maxLength": 128
          },
          "edge_id": {
            "type": "string",
            "maxLength": 260
          }
        }
      }
    },
    "safety_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consecutive_failures",
        "frozen"
      ],
      "properties": {
        "consecutive_failures": {
          "type": "integer",
          "minimum": 0
        },
        "frozen": {
          "type": "boolean"
        }
      }
    },
    "stranded_concepts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "predictive_gain": {
      "type": "number"
    },
    "retiring_predictors": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "retirement_edges": {
      "type": "integer",
      "minimum": 0
    },
    "structural_candidates": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "structural_producers": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "oldest_structural_wait_ticks": {
      "type": "integer",
      "minimum": 0
    },
    "representation_maturity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nascent": {
          "type": "integer",
          "minimum": 0
        },
        "provisional": {
          "type": "integer",
          "minimum": 0
        },
        "mature": {
          "type": "integer",
          "minimum": 0
        },
        "stable": {
          "type": "integer",
          "minimum": 0
        },
        "weakening": {
          "type": "integer",
          "minimum": 0
        },
        "retiring": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "max_contention_losses": {
      "type": "integer",
      "minimum": 0
    },
    "structural_pressure": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "quantization_error": {
      "type": "number",
      "minimum": 0
    },
    "relation_churn": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "developmental_divergence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "generative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "target_id",
        "episode_id",
        "state_count",
        "transition_count",
        "branch_count",
        "max_depth",
        "model_queries",
        "termination",
        "agenda_candidate_count",
        "agenda_contamination_count",
        "factual_contamination_count",
        "hypothesis_count",
        "reconciliation_count",
        "consolidation_signal_count",
        "states",
        "transitions",
        "hypotheses"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "online",
            "idle",
            "offline"
          ]
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "episode_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "state_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "transition_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "branch_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "model_queries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "termination": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "agenda_candidate_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "agenda_contamination_count": {
          "type": "integer",
          "minimum": 0
        },
        "factual_contamination_count": {
          "type": "integer",
          "minimum": 0
        },
        "hypothesis_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "reconciliation_count": {
          "type": "integer",
          "minimum": 0
        },
        "consolidation_signal_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "states": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state_id",
              "parent_state_id",
              "origin",
              "depth",
              "model_ids",
              "uncertainty",
              "coherence"
            ],
            "properties": {
              "state_id": {
                "type": "string",
                "maxLength": 128
              },
              "parent_state_id": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 128
              },
              "origin": {
                "type": "string",
                "maxLength": 32
              },
              "depth": {
                "type": "integer",
                "minimum": 0,
                "maximum": 64
              },
              "model_ids": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "maxLength": 128
                }
              },
              "uncertainty": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "coherence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "transitions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "transition_id",
              "source_state_id",
              "target_state_id",
              "operation",
              "model_ids"
            ],
            "properties": {
              "transition_id": {
                "type": "string",
                "maxLength": 128
              },
              "source_state_id": {
                "type": "string",
                "maxLength": 128
              },
              "target_state_id": {
                "type": "string",
                "maxLength": 128
              },
              "operation": {
                "type": "string",
                "maxLength": 32
              },
              "model_ids": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "maxLength": 128
                }
              }
            }
          }
        },
        "hypotheses": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hypothesis_id",
              "target_id",
              "status",
              "model_ids",
              "uncertainty"
            ],
            "properties": {
              "hypothesis_id": {
                "type": "string",
                "maxLength": 128
              },
              "target_id": {
                "type": "string",
                "maxLength": 128
              },
              "status": {
                "type": "string",
                "maxLength": 32
              },
              "model_ids": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "maxLength": 128
                }
              },
              "uncertainty": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    }
  }
}
